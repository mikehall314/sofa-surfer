{
	"name": "sofa-surfer",
	"version": "0.2.0",
	"description": "A little API for accessing CouchDB",
	"author": "Mike Hall <mikehall314@gmail.com>",
	"license": "MIT",
	"type": "module",
	"devDependencies": {
		"@types/node": "^25.5.0",
		"eslint": "^9.39.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"neostandard": "^0.13.0",
		"npm": "^11.11.1",
		"prettier": "^3.8.1",
		"rimraf": "^6.1.3",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vitest": "^4.1.0"
	},
	"files": [
		"./dist"
	],
	"lint-staged": {
		"*.js": "eslint",
		"*.ts": "eslint"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsup",
		"check": "tsc",
		"clean": "rimraf dist",
		"lint": "eslint .",
		"prebuild": "npm run check",
		"prepack": "npm run build",
		"prepare": "husky",
		"prettier": "prettier -l .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mikehall314/sofa-surfer.git"
	},
	"volta": {
		"node": "25.8.1",
		"npm": "10.9.6"
	}
}
