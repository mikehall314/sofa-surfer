{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowJs": false,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"esModuleInterop": true,
		"types": ["node"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "src/**/*.spec.ts"]
}
